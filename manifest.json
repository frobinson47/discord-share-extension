{
  "manifest_version": 3,
  "name": "Discord Share",
  "version": "1.1.4",
  "description": "Send selected text, links, and images to Discord channels",
  "permissions": ["storage", "contextMenus", "scripting", "activeTab", "notifications"],
  "host_permissions": ["https://discord.com/api/webhooks/*", "https://discord.com/api/*", "https://prompthouse.fmrdigital.dev/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "128": "icons/icon128.png"
  }
}
